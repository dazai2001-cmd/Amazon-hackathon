# Camera access on Android works through HTTPS or trusted localhost.
# With `npm run phone:usb`, use http://localhost:8787 for PHONE_BASE_URL.
PORT=8787
TLS_PORT=8788
# TLS_ENABLED=false when a trusted HTTPS reverse proxy handles TLS.
# DATA_DIR=.local/data
# PHONE_BASE_URL=https://192.168.1.16:8788
